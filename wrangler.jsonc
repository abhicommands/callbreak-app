{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "callbreak-app",
  "main": "worker/index.ts",
  "compatibility_date": "2026-11-24",
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "./client/dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api", "/api/*"]
  },
  "durable_objects": {
    "bindings": [{ "name": "LEDGER", "class_name": "Ledger" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Ledger"] }],
  "env": {
    "preview": {
      "name": "callbreak-ledger-preview",
      "workers_dev": true,
      "preview_urls": false,
      "durable_objects": {
        "bindings": [{ "name": "LEDGER", "class_name": "Ledger" }]
      },
      "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Ledger"] }]
    }
  }
}
